// Sellfinity data model.
// SQLite for local dev; switch provider+url to Postgres for production.
// Conventions: all money is integer cents; "enum" fields are strings with
// allowed values defined in src/lib/types.ts; JSON payloads are serialized
// strings (SQLite) with typed mappers at the read/write boundary.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for the app; direct connection for migrations
  // (connection poolers break Prisma Migrate).
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id                           String    @id @default(cuid())
  email                        String    @unique
  passwordHash                 String
  name                         String
  // USER | ADMIN
  role                         String    @default("USER")
  // FREE | PRO | SCALE
  plan                         String    @default("FREE")
  planRenewsAt                 DateTime?
  // Automatically publish high-confidence profitable Arbitrage Finder matches
  // after a user-initiated scan finishes.
  autoPublishArbitrage         Boolean   @default(false)
  // Apply AI hero-image enhancement to Amazon mirroring and every Arbitrage
  // Finder publishing path, including automatic batches.
  improveMainImage             Boolean   @default(false)
  // Rewrite Amazon source copy into factual, eBay-search-optimized titles and
  // descriptions while retaining Sellfinity's standard HTML template.
  improveListingContent        Boolean   @default(false)
  // Reprice active listings after a matched order proves the realized margin
  // missed the 5% / $7 net-profit floor.
  autoProtectVerifiedProfit    Boolean   @default(false)
  // When enabled, seller-facing pricing uses this modeled net-profit target
  // per unit after Amazon landed cost and eBay fees.
  targetProfitEnabled          Boolean   @default(true)
  // FIXED | AI_RANGE. AI_RANGE chooses a competitive target between the
  // seller's minimum and targetProfitCents (used as the maximum).
  targetProfitMode             String    @default("FIXED")
  targetProfitMinCents         Int       @default(100)
  targetProfitCents            Int       @default(700)
  // AI | FREE_SHIPPING | BUYER_PAID_SHIPPING. AI prefers free shipping and
  // uses up to $7 buyer-paid shipping only when a competitive item price
  // cannot reach the configured profit target.
  pricingStrategy              String    @default("AI")
  // Give a listing a separate price lock after its first profitable sale.
  // The lock expires after seven days without another profitable sale.
  autoLockProfitableListings   Boolean   @default(true)
  // Refill sold active eBay listings to five units whenever live stock falls
  // below two during fulfillment refreshes.
  autoRestockFulfilledListings Boolean   @default(false)
  // Account-wide eBay promotion percentage in basis points (500 = 5%).
  // Protected list prices are grossed up so the discounted checkout price
  // still clears the verified-profit target.
  ebaySitewideDiscountBps      Int       @default(0)
  // Expected Promoted Listings rate in basis points (900 = 9%). Used for
  // projected pricing and modeled profit on imported sales.
  ebayAdRateBps                Int       @default(300)
  createdAt                    DateTime  @default(now())

  sessions                Session[]
  products                Product[]
  listings                Listing[]
  orders                  Order[]
  syncRuns                SyncRun[]
  syncIssues              SyncIssue[]
  ebayListingSuppressions EbayListingSuppression[]
  ebayListingSnapshots    EbayListingSnapshot[]
  ebayMarketMetrics       EbayMarketMetric[]
  hiddenArbitrageItems    HiddenArbitrageItem[]
  mirrorBatches           MirrorBatch[]
  generatedListingImages  GeneratedListingImage[]
  ebayConnection          EbayConnection?
  amazonEmailConnection   AmazonEmailConnection?
  amazonPurchases         AmazonPurchase[]
}

// Read-only Gmail connection used to recognize Amazon order confirmation and
// shipping emails. Tokens are encrypted by the application before storage.
model AmazonEmailConnection {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  provider                String    @default("GOOGLE")
  status                  String    @default("CONNECTED")
  email                   String?
  encryptedAccessToken    String?
  encryptedRefreshToken   String?
  accessTokenExpiresAt    DateTime?
  connectedAt             DateTime  @default(now())
  lastSyncedAt            DateTime?
  lastSyncError           String?
  processedMessageIdsJson String    @default("[]")
  syncVersion             Int       @default(1)
  autoUploadTracking      Boolean   @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// An Amazon purchase recovered from a user-authorized confirmation or
// shipment email. The raw email is never retained.
model AmazonPurchase {
  id                         String    @id @default(cuid())
  userId                     String
  amazonOrderId              String
  sourceMessageId            String
  purchasedAt                DateTime?
  recipientName              String?
  deliveryAddressFingerprint String?
  status                     String    @default("ORDERED")
  subtotalCents              Int?
  shippingCents              Int       @default(0)
  taxCents                   Int       @default(0)
  discountCents              Int       @default(0)
  totalCents                 Int?
  currency                   String    @default("USD")
  trackingNumber             String?
  carrier                    String?
  trackingUrl                String?
  trackingResolvedAt         DateTime?
  trackingLookupError        String?
  trackingAsinsJson          String    @default("[]")
  expectedDeliveryAt         DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  user  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  items AmazonPurchaseItem[]

  @@unique([userId, amazonOrderId])
  @@unique([userId, sourceMessageId])
  @@index([userId, purchasedAt])
  @@index([userId, status])
}

model AmazonPurchaseItem {
  id                     String   @id @default(cuid())
  purchaseId             String
  asin                   String?
  title                  String
  quantity               Int      @default(1)
  unitPriceCents         Int?
  lineTotalCents         Int?
  allocatedShippingCents Int      @default(0)
  allocatedTaxCents      Int      @default(0)
  allocatedDiscountCents Int      @default(0)
  amazonUrl              String?
  matchedOrderId         String?  @unique
  matchConfidence        Int?
  matchReason            String?
  createdAt              DateTime @default(now())

  purchase     AmazonPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  matchedOrder Order?         @relation(fields: [matchedOrderId], references: [id], onDelete: SetNull)

  @@index([purchaseId])
  @@index([asin])
}

// Amazon-first catalog curated by Sellfinity administrators. User-facing
// Arbitrage Finder rows are published from this source of truth only after a
// usable eBay equivalent and market research have been attached.
model AdminArbitrageProduct {
  id                          String    @id @default(cuid())
  asin                        String    @unique
  amazonTitle                 String
  amazonPriceCents            Int
  amazonShippingCents         Int       @default(0)
  amazonUrl                   String
  amazonImageUrl              String?
  // Complete shared Amazon snapshot. The first admin or seller lookup saves
  // these fields so later mirrors of the same ASIN do not buy another API call.
  amazonBrand                 String    @default("")
  amazonDescription           String    @default("")
  amazonBulletPointsJson      String    @default("[]")
  amazonImageUrlsJson         String    @default("[]")
  amazonInStock               Boolean   @default(true)
  amazonRefreshedAt           DateTime?
  category                    String
  isAmazonBestSeller          Boolean   @default(true)
  // PENDING | PUBLISHED | NO_MATCH | ARCHIVED
  status                      String    @default("PENDING")
  ebayItemId                  String?   @unique
  ebayTitle                   String?
  ebayPriceCents              Int?
  ebayUrl                     String?
  ebayImageUrl                String?
  matchVerdict                String    @default("UNVERIFIED")
  matchConfidence             Int       @default(0)
  matchReason                 String?
  estimatedSales30d           Int?
  competitorCount             Int?
  averageCompetitorPriceCents Int?
  ebayRecommendedPriceCents   Int?
  suggestedPriceCents         Int?
  estimatedProfitCents        Int?
  marginPct                   Int?
  lastResearchedAt            DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([status, updatedAt])
  @@index([category])
  @@index([matchConfidence])
  @@index([marginPct])
}

// A durable direct-to-eBay publishing run. The browser advances one item at a
// time so progress survives serverless request limits and every outcome is
// retained for the seller's audit history.
model MirrorBatch {
  id                    String    @id @default(cuid())
  userId                String
  // URL_BULK | ARBITRAGE | LISTING_PUBLISH | LISTING_EDIT |
  // PRICE_OPTIMIZATION | AI_OPTIMIZATION | LISTING_END | LISTING_SYNC
  source                String
  // MANUAL | AUTOMATIC
  trigger               String    @default("MANUAL")
  // When enabled, the Amazon main photo is edited into an eBay-compliant
  // studio hero image before the listing is published.
  improveMainImage      Boolean   @default(false)
  // Snapshot the copy preference so an in-flight batch behaves consistently.
  improveListingContent Boolean   @default(false)
  // PENDING | RUNNING | COMPLETED
  status                String    @default("PENDING")
  totalCount            Int
  succeededCount        Int       @default(0)
  failedCount           Int       @default(0)
  // PENDING | SENDING | SENT | FAILED
  emailStatus           String    @default("PENDING")
  emailSentAt           DateTime?
  emailError            String?
  createdAt             DateTime  @default(now())
  startedAt             DateTime?
  completedAt           DateTime?

  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items MirrorBatchItem[]

  @@index([userId, createdAt])
  @@index([userId, status])
}

model MirrorBatchItem {
  id                     String    @id @default(cuid())
  batchId                String
  position               Int
  inputUrl               String
  sourceReferenceId      String?
  // PENDING | PROCESSING | SUCCEEDED | FAILED
  status                 String    @default("PENDING")
  title                  String?
  sourcePriceCents       Int?
  listingPriceCents      Int?
  listingId              String?
  ebayListingId          String?
  error                  String?
  // NOT_REQUESTED | PENDING | GENERATING | SUCCEEDED | FALLBACK
  imageImprovementStatus String    @default("NOT_REQUESTED")
  imageImprovementError  String?
  attempts               Int       @default(0)
  createdAt              DateTime  @default(now())
  startedAt              DateTime?
  completedAt            DateTime?

  batch MirrorBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, position])
  @@index([batchId, status])
}

// Durable public image bytes used by eBay while it imports an AI-edited hero
// photo. IDs are unguessable and the route exposes no seller information.
model GeneratedListingImage {
  id        String   @id @default(cuid())
  userId    String
  mimeType  String   @default("image/jpeg")
  data      Bytes
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// A seller explicitly ended this item through Sellfinity. eBay's ActiveList
// can continue returning ended items for a while, so keep a durable local
// tombstone instead of letting the stale remote row reappear.
model EbayListingSuppression {
  id            String   @id @default(cuid())
  userId        String
  ebayListingId String
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ebayListingId])
  @@index([userId])
}

// Cached market research for one of the seller's eBay listings. Refreshed on
// demand in batches so opening Listings never fans out hundreds of API calls.
model EbayMarketMetric {
  id                          String   @id @default(cuid())
  userId                      String
  ebayListingId               String
  estimatedSales30d           Int
  competitorCount             Int
  averageCompetitorPriceCents Int
  bestSellingPriceCents       Int?
  query                       String
  updatedAt                   DateTime @updatedAt
  createdAt                   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ebayListingId])
  @@index([userId])
}

// Durable eBay Analytics totals. Pages reuse these snapshots instead of
// spending the seller's small daily traffic-report allowance on every visit.
model EbayListingTrafficSnapshot {
  id                  String   @id @default(cuid())
  userId              String
  ebayListingId       String
  periodStart         DateTime
  periodEnd           DateTime
  impressions         Int?
  views               Int?
  clickThroughRate    Float?
  salesConversionRate Float?
  fetchedAt           DateTime @default(now())

  @@unique([userId, ebayListingId])
  @@index([userId, fetchedAt])
}

// Daily points are cached by report scope. ACCOUNT powers the main dashboard;
// a stable listing-set key powers an individual ASIN graph.
model EbayTrafficDailySnapshot {
  id          String   @id @default(cuid())
  userId      String
  scopeKey    String
  date        DateTime
  impressions Int
  views       Int
  fetchedAt   DateTime @default(now())

  @@unique([userId, scopeKey, date])
  @@index([userId, scopeKey, date])
}

model Session {
  id        String   @id // random 256-bit token, also the cookie value
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// The user's eBay seller account connection. Placeholder until real OAuth:
// status SANDBOX means our mock client is in use; CONNECTED is reserved for
// a real token exchange.
model EbayConnection {
  id                   String    @id @default(cuid())
  userId               String    @unique
  // DISCONNECTED | SANDBOX | CONNECTED
  status               String    @default("DISCONNECTED")
  ebayUsername         String?
  // OAuth tokens (encrypt at rest before production).
  accessToken          String?
  accessTokenExpiresAt DateTime?
  refreshToken         String?
  // Snapshot of the scopes granted by the latest OAuth consent. Older
  // connections without sell.finances must reconnect before actual order
  // earnings can replace fee estimates.
  oauthScopesJson      String    @default("[]")
  connectedAt          DateTime?
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Retained copy of eBay's active-listing response. Normal page loads read
// this table; only an intentional Smart Sync refresh calls eBay again.
model EbayListingSnapshot {
  id            String    @id @default(cuid())
  userId        String
  ebayListingId String
  title         String
  priceCents    Int
  url           String
  imageUrl      String?
  quantity      Int?
  listingDate   DateTime?
  lastSeenAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ebayListingId])
  @@index([userId, lastSeenAt])
}

// A product the user imported from the sourcing feed or mirrored from an
// Amazon URL. Supplier fields snapshot the supplier state at import; sync
// refreshes them.
model Product {
  id                  String    @id @default(cuid())
  userId              String
  sku                 String
  title               String
  // Manufacturer brand retained from Amazon for category compliance on eBay.
  brand               String    @default("")
  description         String
  // JSON string array of image URLs
  imageUrlsJson       String    @default("[]")
  category            String
  supplierName        String
  supplierProductId   String
  supplierUrl         String
  costCents           Int
  supplierStock       Int
  /**
   * Estimated cost for the seller to ship one unit to the buyer.
   */
  shippingCostCents   Int       @default(0)
  // Last time Amazon price, shipping, and availability were explicitly refreshed.
  amazonRefreshedAt   DateTime?
  suggestedPriceCents Int
  // 0-100 sourcing score at import time
  sourceScore         Int
  createdAt           DateTime  @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings Listing[]

  @@unique([userId, sku])
  @@index([userId])
  @@index([userId, amazonRefreshedAt])
}

// An eBay listing for a product. Mirrors what we believe the live eBay state
// to be; ebayListingId is set on publish (mock IDs in sandbox mode).
model Listing {
  id                    String    @id @default(cuid())
  userId                String
  productId             String
  ebayListingId         String?
  title                 String
  description           String
  priceCents            Int
  // The item-level price presentation selected when this listing was last
  // priced. Buyer-paid shipping is capped at $7 by application policy.
  shippingStrategy      String    @default("FREE_SHIPPING")
  buyerShippingCents    Int       @default(0)
  quantity              Int
  imageUrlsJson         String    @default("[]")
  // DRAFT | ACTIVE | ENDED
  status                String    @default("DRAFT")
  // UNVERIFIED | MATCH | LIKELY | REVIEW | REJECTED
  sourceMatchVerdict    String    @default("UNVERIFIED")
  sourceMatchConfidence Int?
  sourceMatchReason     String?
  sourceMatchMethod     String?
  sourceMatchCheckedAt  DateTime?
  publishedAt           DateTime?
  endedAt               DateTime?
  // MANUAL | SOURCE_UNAVAILABLE | EBAY_ENDED. Smart Sync can recover MANUAL
  // and SOURCE_UNAVAILABLE listings after re-verifying source and margin.
  endedReason           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orders     Order[]
  syncIssues SyncIssue[]

  @@index([userId, status])
  @@index([userId, status, sourceMatchVerdict])
  @@index([userId, status, endedReason])
}

// A sale imported from eBay. Fee/cost fields are snapshotted at import so the
// P&L is stable even if fee rates or supplier costs change later.
model Order {
  id                         String    @id @default(cuid())
  userId                     String
  listingId                  String
  ebayOrderId                String
  quantity                   Int
  // per-unit sale price
  salePriceCents             Int
  shippingChargedCents       Int       @default(0)
  ebayFeeCents               Int
  // Finalized eBay order earnings. Null means the dashboard must use the
  // legacy fee estimate until the Finances API publishes the transaction.
  ebayCheckoutOrderId        String?
  ebayGrossAmountCents       Int?
  ebayOrderEarningsCents     Int?
  ebayTransactionFeeCents    Int?
  ebayAdvertisingFeeCents    Int?
  ebayOtherFeeCents          Int?
  ebayShippingLabelCents     Int?
  ebayRefundCents            Int?
  ebayFeeBreakdownJson       String    @default("[]")
  // ESTIMATED | ACTUAL
  ebayFinancialsSource       String    @default("ESTIMATED")
  ebayFinancialsCheckedAt    DateTime?
  ebayFinancialsUpdatedAt    DateTime?
  ebayFinancialsError        String?
  shippingCostCents          Int
  cogsCents                  Int // total cost of goods for this order
  // PAID | SHIPPED | REFUNDED
  status                     String    @default("PAID")
  buyerUsername              String
  shippingRecipientName      String?
  shippingAddressFingerprint String?
  saleDate                   DateTime
  createdAt                  DateTime  @default(now())

  // Reconciled Amazon fulfillment data. Catalog COGS remains the estimate;
  // realized dashboards use the linked purchase item's allocated actual cost.
  sourcingStatus        String    @default("NOT_PURCHASED")
  amazonMatchedAt       DateTime?
  ebayTrackingNumber    String?
  ebayTrackingCarrier   String?
  ebayTrackingSyncedAt  DateTime?
  ebayTrackingSyncError String?

  // Result of applying the verified-cost future-profit protection policy.
  // NOT_REQUIRED | ADJUSTED | RELISTED | ALREADY_PROTECTED | REVIEW_REQUIRED | FAILED
  profitProtectionStatus        String?
  profitProtectionReviewedAt    DateTime?
  profitProtectionOldPriceCents Int?
  profitProtectionNewPriceCents Int?
  profitProtectionError         String?

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing            Listing             @relation(fields: [listingId], references: [id], onDelete: Cascade)
  amazonPurchaseItem AmazonPurchaseItem?

  @@unique([userId, ebayOrderId])
  @@index([userId, saleDate])
  @@index([userId, ebayCheckoutOrderId])
  @@index([userId, ebayFinancialsSource, saleDate])
}

model SyncRun {
  id              String    @id @default(cuid())
  userId          String
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  listingsChecked Int       @default(0)
  issuesFound     Int       @default(0)
  issuesAutoFixed Int       @default(0)

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  issues SyncIssue[]

  @@index([userId, startedAt])
}

// A researched arbitrage opportunity: a live eBay listing paired with a
// cheaper Amazon source. Global (shared by all users); grows as scans run.
model ArbitrageItem {
  id                    String                @id @default(cuid())
  ebayItemId            String                @unique
  ebayTitle             String
  ebayPriceCents        Int
  ebayUrl               String
  imageUrl              String
  category              String
  asin                  String
  amazonTitle           String
  amazonPriceCents      Int
  amazonShippingCents   Int                   @default(0)
  amazonUrl             String
  profitCents           Int
  marginPct             Int
  feeCents              Int
  salesEst              Int
  competitorCount       Int?
  avgCompPriceCents     Int?
  // Lower-quartile competitive eBay price retained from discovery and copied
  // to the seller's listing market snapshot after publication.
  bestSellingPriceCents Int?
  matchVerdict          String                @default("UNVERIFIED")
  matchConfidence       Int                   @default(0)
  matchReason           String?
  matchMethod           String                @default("RULES")
  matchCheckedAt        DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  hiddenBy              HiddenArbitrageItem[]

  @@index([profitCents])
  @@index([category])
  @@index([createdAt])
  @@index([asin])
  @@index([matchVerdict, matchConfidence])
}

// Per-user dismissal of a shared arbitrage research row.
model HiddenArbitrageItem {
  id         String   @id @default(cuid())
  userId     String
  ebayItemId String
  createdAt  DateTime @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  item ArbitrageItem @relation(fields: [ebayItemId], references: [ebayItemId], onDelete: Cascade)

  @@unique([userId, ebayItemId])
  @@index([userId])
  @@index([ebayItemId])
}

// Generic JSON cache for expensive external scans (e.g. the daily arbitrage
// scan, which costs paid API credits) — shared across users.
model ScanCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  dataJson  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Shared paid-provider response cache. Amazon catalog identity changes slowly,
// while live price/availability entries use short expirations in application
// code. A lease prevents concurrent serverless workers buying the same lookup.
model RainforestCache {
  cacheKey     String    @id
  requestType  String
  responseJson String?
  expiresAt    DateTime
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([expiresAt])
  @@index([requestType, expiresAt])
}

// Aggregated operational accounting; never stores API keys or response data.
model RainforestUsageDaily {
  id               String   @id @default(cuid())
  day              String
  workflow         String
  requestType      String
  providerRequests Int      @default(0)
  cacheHits        Int      @default(0)
  failures         Int      @default(0)
  budgetBlocks     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([day, workflow, requestType])
  @@index([day])
}

// Durable negative/positive scan memory. Rejected eBay candidates are not
// paid for again on every daily cursor rotation.
model ArbitrageCandidateAttempt {
  ebayItemId String   @id
  outcome    String
  retryAfter DateTime
  checkedAt  DateTime @default(now())

  @@index([retryAfter])
}

// A detected mismatch between supplier truth and the live listing.
model SyncIssue {
  id          String    @id @default(cuid())
  syncRunId   String
  userId      String
  listingId   String
  // OUT_OF_STOCK | STOCK_DRIFT | COST_RISE | SUPPLIER_GONE
  type        String
  // JSON string: { field, expected, actual, ... } for display
  detailsJson String
  // OPEN | AUTO_FIXED | FIXED | IGNORED
  resolution  String    @default("OPEN")
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  syncRun SyncRun @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([userId, resolution])
}
