{
  "manifest_version": 3,
  "name": "Sellfinity Amazon Tracking Helper",
  "version": "1.2.0",
  "description": "Automatically checks Amazon tracking pages and saves carrier tracking to Sellfinity fulfillment.",
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "https://www.sellfinity.app/*",
    "https://*.amazon.com/*",
    "https://*.ups.com/*",
    "https://*.fedex.com/*",
    "https://*.usps.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Sellfinity Tracking Helper",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.sellfinity.app/orders*"],
      "js": ["sellfinity-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.amazon.com/*",
        "https://*.ups.com/*",
        "https://*.fedex.com/*",
        "https://*.usps.com/*"
      ],
      "js": ["tracking.js", "amazon-price.js", "amazon-content.js"],
      "run_at": "document_idle"
    }
  ]
}
